# =============================================================================
# Reactive Finance Ratpack — Environment Variables Template
#
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application — required
# -----------------------------------------------------------------------------

# Selects the active configuration profile.
# Corresponds to src/main/resources/application-{RATPACK_ENVIRONMENT}.yml.
# Available built-in profiles: localhost | docker
RATPACK_ENVIRONMENT=docker

# -----------------------------------------------------------------------------
# Application — optional overrides
# (Ratpack maps SOME__KEY → some.key in the config tree, so these override
#  the matching values in the selected application-*.yml file at startup.)
# -----------------------------------------------------------------------------

# Override the HTTP port (default: 5051 as set in application-docker.yml)
# SERVER__DEFAULTPORT=5051

# Override JDBC connection details without touching config files.
# JDBC__URL=jdbc:mariadb://db:3306/dboFinance
# JDBC__USERNAME=dboFinance
# JDBC__PASSWORD=change_me

# -----------------------------------------------------------------------------
# Database (MariaDB) — used by docker-compose.yml
# -----------------------------------------------------------------------------

# Root password for the MariaDB instance (keep secret in production)
MARIADB_ROOT_PASSWORD=change_me_root

# Application database name, user and password
MARIADB_DATABASE=dboFinance
MARIADB_USER=dboFinance
MARIADB_PASSWORD=change_me

# Convenience aliases used by the app service in docker-compose.yml
# These must use double-underscore (Ratpack maps SOME__KEY → some.key).
JDBC__URL=jdbc:mariadb://db:3306/dboFinance
JDBC__USERNAME=dboFinance
JDBC__PASSWORD=change_me

# -----------------------------------------------------------------------------
# Docker Compose — port mapping overrides
# -----------------------------------------------------------------------------

# Host port to expose the MariaDB service on (default: 3306)
DB_EXPOSE_PORT=3306

# Host port to expose the application on (default: 5051)
APP_PORT=5051

# -----------------------------------------------------------------------------
# Docker image — optional
# -----------------------------------------------------------------------------

# Override the app image name/tag used by docker-compose
# APP_IMAGE=ghcr.io/markngoma/reactive-finance-ratpack:latest
